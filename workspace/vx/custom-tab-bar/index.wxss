.tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e5eaf0;
  background: #fff;
  box-shadow: 0 -6rpx 18rpx rgba(30, 55, 80, 0.06);
}

.tab-item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  flex-direction: column;
  color: #7f8b98;
  font-size: 22rpx;
}

.tab-item.is-active {
  color: #2d8cf0;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}
