.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 96rpx 24rpx;
  color: #617080;
  font-size: 26rpx;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid #c7dff7;
  border-top-color: #2d8cf0;
  border-radius: 50%;
  animation: loading-spin 0.8s linear infinite;
}

.loading-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: #eaf4fe;
  border-radius: 50%;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}
