<view class="empty-state">
  <view class="empty-mark"><app-icon name="inbox" size="58" muted></app-icon></view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-description">{{description}}</view>
  <button wx:if="{{actionText}}" class="empty-action" bindtap="handleAction"><app-icon name="refresh-cw" size="30"></app-icon><text>{{actionText}}</text></button>
</view>
