<view class="page profile-page">
  <loading-state wx:if="{{loading && !user}}"></loading-state>
  <empty-state wx:elif="{{error && !user}}" title="用户信息加载失败" description="{{error}}" action-text="重试" bind:action="loadUser"></empty-state>
  <block wx:else>
    <view class="identity-card surface">
      <view class="avatar"><text>MES</text></view>
      <view class="identity-main"><text class="username">{{user.username || '-'}}</text><text class="employee">{{user.roles && user.roles.length ? user.roles[0] : 'MES 操作人员'}}</text><text class="identity-system">{{user.employeeId ? ('员工 ID ' + user.employeeId) : '羽球智造 MES'}}</text></view>
    </view>

    <view class="settings-list surface">
      <view class="setting-row" bindtap="showAbout"><view class="setting-main"><view class="setting-icon"><app-icon name="info" size="30"></app-icon></view><text>关于 MES</text></view><app-icon name="chevron-right" size="28" muted></app-icon></view>
      <view class="setting-row" bindtap="toggleAccount"><view class="setting-main"><view class="setting-icon"><app-icon name="badge-check" size="30"></app-icon></view><text>账号与权限</text></view><app-icon name="chevron-right" size="28" muted></app-icon></view>
      <view class="setting-row" bindtap="showHelp"><view class="setting-main"><view class="setting-icon"><app-icon name="circle-check-big" size="30"></app-icon></view><text>帮助中心</text></view><app-icon name="chevron-right" size="28" muted></app-icon></view>
      <view class="setting-row" bindtap="showCompany"><view class="setting-main"><view class="setting-icon"><app-icon name="factory" size="30"></app-icon></view><text>关于我们</text></view><app-icon name="chevron-right" size="28" muted></app-icon></view>
      <view class="setting-row" bindtap="showPasswordHint"><view class="setting-main"><view class="setting-icon"><app-icon name="lock-keyhole" size="30"></app-icon></view><text>修改密码</text></view><app-icon name="chevron-right" size="28" muted></app-icon></view>
    </view>

    <view wx:if="{{showAccount}}" class="account-panel surface"><view class="field-row"><text class="field-label">用户 ID</text><text class="field-value">{{user.userId}}</text></view><view class="field-row"><text class="field-label">最近登录</text><text class="field-value">{{user.lastLoginTimeText}}</text></view><view class="permission-heading">角色与权限</view><view wx:if="{{user.roles && user.roles.length}}" class="tag-list"><text wx:for="{{user.roles}}" wx:key="*this">{{item}}</text></view><view wx:if="{{user.permissions && user.permissions.length}}" class="permission-list"><text wx:for="{{user.permissions}}" wx:key="*this">{{item}}</text></view><view wx:else class="muted">未分配权限</view></view>

    <view class="switch-button" bindtap="switchAccount"><app-icon name="refresh-cw" size="32" inverse></app-icon><text>切换登录</text></view>
    <view class="logout-button" bindtap="logout"><app-icon name="log-out" size="32" inverse></app-icon><text>退出系统</text></view>
  </block>
</view>
