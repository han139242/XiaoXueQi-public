.profile-page {
  padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  color: #ffffff;
  background: #2d8cf0;
  border-radius: 50%;
  font-size: 25rpx;
  font-weight: 650;
}

.identity-main {
  min-width: 0;
  flex: 1;
}

.username,
.employee {
  display: block;
}

.identity-system {
  display: block;
  margin-top: 5rpx;
  color: #88929c;
  font-size: 23rpx;
}

.username {
  color: #202a36;
  font-size: 32rpx;
  font-weight: 650;
}

.employee {
  margin-top: 8rpx;
  color: #66717d;
  font-size: 25rpx;
}

.settings-list { margin-top: 20rpx; padding: 0 24rpx; }

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-list text {
  padding: 10rpx 14rpx;
  color: #176fbe;
  background: #e6f2fd;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.permission-list { max-height: 260rpx; overflow-y: auto; }

.permission-list text {
  display: block;
  padding: 12rpx 0;
  color: #617080;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 14rpx 0;
  color: #202a36;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid #dfe4e9;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: left;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-row view {
  min-width: 0;
}

.setting-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 14rpx;
}

.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  background: #eaf4fe;
  border-radius: 8rpx;
}

.account-panel { margin-top: 20rpx; padding: 20rpx 24rpx; }
.account-panel .field-row + .field-row { border-top: 1rpx solid #edf0f3; }
.permission-heading { margin: 16rpx 0 12rpx; color: #202a36; font-size: 27rpx; font-weight: 600; }
.switch-button, .logout-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 84rpx; margin-top: 20rpx; color: #ffffff; border-radius: 6rpx; font-size: 29rpx; }
.switch-button { background: #2d8cf0; }
.logout-button { margin-top: 14rpx; background: #4aa6e8; }
