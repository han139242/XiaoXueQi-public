.login-page {
  min-height: 100vh;
  background: #f3f6f9;
}

.login-header {
  min-height: 330rpx;
  padding: 92rpx 48rpx 110rpx;
  color: #ffffff;
  background: #2d8cf0;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 8rpx;
}

.brand-name {
  font-size: 42rpx;
  font-weight: 700;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #dcecff;
  font-size: 26rpx;
}

.header-line {
  width: 92rpx;
  height: 6rpx;
  margin-top: 34rpx;
  background: #ffffff;
  border-radius: 3rpx;
  opacity: 0.86;
}

.login-body {
  margin-top: -76rpx;
  padding: 0 36rpx 52rpx;
}

.login-panel {
  padding: 34rpx 32rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8ee;
  border-radius: 10rpx;
  box-shadow: 0 14rpx 40rpx rgba(32, 42, 54, 0.12);
}

.login-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.login-heading__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  background: #eaf4fe;
  border-radius: 8rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 650;
}

.login-caption {
  margin-top: 5rpx;
  color: #8a96a3;
  font-size: 23rpx;
}

.input-field {
  display: block;
  margin-top: 22rpx;
}

.input-label {
  display: block;
  margin-bottom: 10rpx;
  color: #617080;
  font-size: 24rpx;
}

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  color: #bf433e;
  background: #fbeeed;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.login-button {
  margin-top: 30rpx;
  box-shadow: 0 8rpx 18rpx rgba(45, 140, 240, 0.22);
}

.login-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 22rpx;
  color: #8a96a3;
  font-size: 22rpx;
}
