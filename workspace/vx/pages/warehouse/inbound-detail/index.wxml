<view class="page detail-page">
  <loading-state wx:if="{{loading && !detail}}"></loading-state>
  <empty-state wx:elif="{{error && !detail}}" title="入库详情加载失败" description="{{error}}" action-text="重试" bind:action="loadDetail"></empty-state>
  <view wx:elif="{{detail}}" class="detail-stack">
    <view class="detail-hero">
      <view class="detail-hero__header">
        <view class="detail-hero__identity"><view class="detail-hero__icon"><app-icon name="inbox" size="38"></app-icon></view><text class="detail-hero__number" selectable>{{detail.inboundNo || ('入库单 ' + detail.inboundId)}}</text></view>
        <status-tag text="{{detail.statusText}}" tone="{{detail.statusTone}}"></status-tag>
      </view>
      <view class="detail-fields">
        <view><text>入库仓库</text><text>{{detail.warehouseLabel}}</text></view>
        <view><text>来源类型</text><text>{{detail.sourceOrderType || '-'}}</text></view>
        <view><text>入库时间</text><text>{{detail.inboundTimeText}}</text></view>
        <view><text>创建时间</text><text>{{detail.createdTimeText}}</text></view>
      </view>
    </view>
    <view class="detail-card">
      <view class="section-title">入库明细</view>
      <view wx:for="{{lines}}" wx:key="detailId" class="line-item">
        <view class="line-title"><text>{{item.materialLabel}}</text><text>{{item.inboundQuantity}}</text></view>
        <view class="line-sub">{{item.batchLabel}} · {{item.locationLabel}}</view>
      </view>
      <view wx:if="{{lines.length === 0}}" class="line-empty">暂无明细</view>
    </view>
    <view class="detail-card">
      <view class="section-title">备注</view>
      <view class="remark-text">{{detail.remarkText}}</view>
    </view>
    <button wx:if="{{canConfirm && detail.auditStatus === 'SUBMITTED'}}" class="primary-button" bindtap="confirmOrder">确认入库</button>
  </view>
</view>
