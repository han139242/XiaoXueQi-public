<view class="page warehouse-page">
  <loading-state wx:if="{{loading && list.length === 0}}"></loading-state>
  <empty-state wx:elif="{{error && list.length === 0}}" title="入库单加载失败" description="{{error}}" action-text="重试" bind:action="loadPage"></empty-state>
  <empty-state wx:elif="{{!loading && list.length === 0}}" title="暂无入库单"></empty-state>
  <view wx:else class="record-list">
    <view wx:for="{{list}}" wx:key="inboundId" class="record-card" data-id="{{item.inboundId}}" bindtap="openDetail">
      <view class="record-header">
        <view class="record-identity"><view class="record-icon"><app-icon name="inbox" size="34"></app-icon></view><view><text class="record-number" selectable>{{item.inboundNo || ('入库单 ' + item.inboundId)}}</text><text class="record-subline">{{item.typeText}}</text></view></view>
        <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}"></status-tag>
      </view>
      <view class="module-fields">
        <view><text>入库仓库</text><text>{{item.warehouseLabel}}</text></view>
        <view><text>来源类型</text><text>{{item.sourceOrderType || '-'}}</text></view>
        <view><text>入库时间</text><text>{{item.timeText}}</text></view>
      </view>
      <view class="record-footer">
        <view class="card-link"><text>查看详情</text><app-icon name="chevron-right" size="25" muted></app-icon></view>
        <view wx:if="{{item.auditStatus === 'SUBMITTED'}}" class="mini-action" data-id="{{item.inboundId}}" catchtap="confirmOrder">确认入库</view>
      </view>
    </view>
    <view wx:if="{{error}}" class="append-error" bindtap="onReachBottom">{{error}}，点击重试</view>
    <view wx:elif="{{loading}}" class="list-footer">加载中</view>
    <view wx:elif="{{finished}}" class="list-footer">已加载全部</view>
  </view>
</view>
