<view class="page detail-page">
  <loading-state wx:if="{{loading && !detail}}"></loading-state>
  <empty-state wx:elif="{{error && !detail}}" title="生产订单详情加载失败" description="{{error}}" action-text="重试" bind:action="loadDetail"></empty-state>
  <view wx:elif="{{detail}}" class="detail-stack">
    <view class="detail-hero">
      <view class="detail-hero__header">
        <view class="detail-hero__identity"><view class="detail-hero__icon"><app-icon name="factory" size="38"></app-icon></view><text class="detail-hero__number" selectable>{{detail.productionOrderNo || ('生产订单 ' + detail.productionOrderId)}}</text></view>
        <status-tag text="{{detail.statusView.text}}" tone="{{detail.statusView.tone}}"></status-tag>
      </view>
      <view class="detail-fields">
        <view><text>客户</text><text>{{detail.customerLabel}}</text></view>
        <view><text>产品</text><text>{{detail.productLabel}}</text></view>
        <view><text>订单数量</text><text>{{detail.orderQuantity}}</text></view>
        <view><text>交付日期</text><text>{{detail.deliveryDateText}}</text></view>
        <view><text>来源类型</text><text>{{detail.sourceText}}</text></view>
        <view><text>创建时间</text><text>{{detail.createdTimeText}}</text></view>
        <view><text>更新时间</text><text>{{detail.updatedTimeText}}</text></view>
      </view>
    </view>
    <view class="detail-card">
      <view class="section-title">备注</view>
      <view class="remark-text">{{detail.remarkText}}</view>
    </view>
  </view>
</view>
