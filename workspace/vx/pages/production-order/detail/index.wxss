.detail-page { padding-top: 22rpx; background: #f4f6f8; }
.detail-stack { display: flex; flex-direction: column; gap: 18rpx; }
.detail-card { padding: 22rpx; background: #ffffff; border: 1rpx solid #e2e8ee; border-radius: 8rpx; }
.detail-fields > view { display: flex; justify-content: space-between; gap: 22rpx; padding: 9rpx 0; color: #7a848e; font-size: 26rpx; line-height: 1.45; }
.detail-fields > view text:last-child { min-width: 0; color: #202a36; text-align: right; overflow-wrap: anywhere; }
.remark-text { color: #3e4852; font-size: 27rpx; line-height: 1.55; overflow-wrap: anywhere; }
