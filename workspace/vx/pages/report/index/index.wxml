<view class="filter-shell">
  <view class="reference-filter-bar">
    <view class="reference-filter {{auditStatus ? 'reference-filter--active' : ''}}" data-field="audit" bindtap="toggleDropdown"><text>状态</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
    <view class="reference-filter {{sortIndex ? 'reference-filter--active' : ''}}" data-field="sort" bindtap="toggleDropdown"><text>排序</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
    <view class="reference-filter {{employeeId && myOnly ? 'reference-filter--active' : ''}}" data-field="scope" bindtap="toggleDropdown"><text>报工范围</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
  </view>
  <view wx:if="{{activeDropdown}}" class="reference-dropdown">
    <view wx:for="{{dropdownOptions}}" wx:key="index" class="dropdown-option {{item.selected ? 'dropdown-option--active' : ''}}" data-field="{{activeDropdown}}" data-index="{{item.index}}" bindtap="selectDropdown">
      <text>{{item.label}}</text>
      <app-icon wx:if="{{item.selected}}" name="circle-check-big" size="30"></app-icon>
    </view>
  </view>
</view>
<view class="page list-page">
  <loading-state wx:if="{{loading && list.length === 0}}"></loading-state>
  <empty-state wx:elif="{{error && list.length === 0}}" title="报工记录加载失败" description="{{error}}" action-text="重试" bind:action="search"></empty-state>
  <empty-state wx:elif="{{!loading && list.length === 0}}" title="暂无报工记录"></empty-state>
  <view wx:else class="record-list">
    <view wx:for="{{list}}" wx:key="reportId" class="record-card" data-id="{{item.reportId}}" bindtap="openDetail">
      <view class="record-header"><text class="record-number" selectable>{{item.reportNo || item.reportTimeText || ('报工 ID ' + item.reportId)}}</text><status-tag text="{{item.statusView.text}}" tone="{{item.statusView.tone}}"></status-tag></view>
      <view class="report-fields"><view><text>任务编号</text><text selectable>{{item.taskNo}}</text></view><view><text>工位名称</text><text>{{item.stationLabel}}</text></view><view><text>操作人员</text><text>{{item.operatorLabel}}</text></view><view><text>报工数量</text><text>合格 {{item.qualifiedQuantity == null ? '-' : item.qualifiedQuantity}} / 不良 {{item.defectQuantity == null ? '-' : item.defectQuantity}}</text></view></view>
      <view class="record-footer"><text>查看详情</text><app-icon name="chevron-right" size="25" muted></app-icon></view>
    </view>
    <view wx:if="{{error}}" class="append-error" bindtap="onReachBottom">{{error}}，点击重试</view><view wx:elif="{{loading}}" class="list-footer">加载中</view><view wx:elif="{{finished}}" class="list-footer">已加载全部</view>
  </view>
</view>
