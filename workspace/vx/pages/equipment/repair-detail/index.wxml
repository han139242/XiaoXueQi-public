<view class="page detail-page">
  <loading-state wx:if="{{loading && !detail}}"></loading-state>
  <empty-state wx:elif="{{error && !detail}}" title="维修详情加载失败" description="{{error}}" action-text="重试" bind:action="loadDetail"></empty-state>
  <view wx:elif="{{detail}}" class="detail-stack">
    <view class="detail-hero">
      <view class="detail-hero__header">
        <view class="detail-hero__identity"><view class="detail-hero__icon"><app-icon name="notebook-pen" size="38"></app-icon></view><text class="detail-hero__number" selectable>{{detail.repairNo || ('维修单 ' + detail.repairId)}}</text></view>
        <status-tag text="{{detail.statusText}}" tone="{{detail.statusTone}}"></status-tag>
      </view>
      <view class="detail-fields">
        <view><text>设备</text><text>{{detail.equipmentLabel}}</text></view>
        <view><text>报修人</text><text>{{detail.reporterLabel}}</text></view>
        <view><text>维修人</text><text>{{detail.repairerLabel}}</text></view>
        <view><text>报修时间</text><text>{{detail.reportedTimeText}}</text></view>
        <view><text>最后更新</text><text>{{detail.updatedTimeText}}</text></view>
      </view>
    </view>
    <view class="detail-card"><view class="section-title">故障描述</view><view class="remark-text">{{detail.faultText}}</view></view>
    <view class="detail-card"><view class="section-title">维修结果</view><view class="remark-text">{{detail.resultText}}</view></view>
    <view class="detail-actions">
      <button wx:if="{{canAssign && detail.status === 'SUBMITTED'}}" class="primary-button" bindtap="assignRepair">派工</button>
      <button wx:if="{{canClose && (detail.status === 'REPAIRING' || detail.status === 'WAIT_ACCEPTANCE')}}" class="primary-button" bindtap="closeRepair">关闭维修单</button>
    </view>
  </view>
</view>
