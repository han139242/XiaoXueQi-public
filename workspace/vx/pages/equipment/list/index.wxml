<view class="equipment-search">
  <view class="search-shell">
    <app-icon name="search" size="30" muted></app-icon>
    <input value="{{keyword}}" placeholder="搜索设备名称或编码" confirm-type="search" bindinput="handleKeyword" bindconfirm="search" />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword"><app-icon name="trash-2" size="28" muted></app-icon></view>
  </view>
  <button class="search-button" bindtap="search">搜索</button>
</view>
<view class="page equipment-page">
  <loading-state wx:if="{{loading && list.length === 0}}"></loading-state>
  <empty-state wx:elif="{{error && list.length === 0}}" title="设备台账加载失败" description="{{error}}" action-text="重试" bind:action="loadPage"></empty-state>
  <empty-state wx:elif="{{!loading && list.length === 0}}" title="暂无设备"></empty-state>
  <view wx:else class="record-list">
    <view wx:for="{{list}}" wx:key="equipmentId" class="record-card" data-id="{{item.equipmentId}}" bindtap="openDetail">
      <view class="record-header">
        <view class="record-identity"><view class="record-icon"><app-icon name="wrench" size="34"></app-icon></view><view><text class="record-number" selectable>{{item.equipmentName}}</text><text class="record-subline">{{item.equipmentCode}}</text></view></view>
        <status-tag text="{{item.statusText}}" tone="{{item.statusTone}}"></status-tag>
      </view>
      <view class="module-fields">
        <view><text>规格型号</text><text>{{item.model || '-'}}</text></view>
        <view><text>所在工位</text><text>{{item.stationLabel}}</text></view>
        <view><text>更新时间</text><text>{{item.updatedTimeText}}</text></view>
      </view>
      <view class="record-footer">
        <view class="card-link"><text>查看设备详情</text><app-icon name="chevron-right" size="25" muted></app-icon></view>
      </view>
    </view>
    <view wx:if="{{error}}" class="append-error" bindtap="onReachBottom">{{error}}，点击重试</view>
    <view wx:elif="{{loading}}" class="list-footer">加载中</view>
    <view wx:elif="{{finished}}" class="list-footer">已加载全部</view>
  </view>
</view>
