.quality-page {
  padding-top: 24rpx;
}

.inspection-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.inspection-card {
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8ee;
  border-radius: 8rpx;
}

.inspection-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.title-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
  color: #202a36;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.35;
}

.title-main text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.title-marker {
  width: 8rpx;
  height: 34rpx;
  flex: 0 0 8rpx;
  background: #20a8f2;
}

.inspection-fields > view {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  padding: 8rpx 0;
  color: #7a848e;
  font-size: 25rpx;
  line-height: 1.45;
}

.inspection-fields > view text:last-child {
  min-width: 0;
  color: #202a36;
  text-align: right;
  overflow-wrap: anywhere;
}

.inspection-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0f3;
}

.action-pass,
.action-fail {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  gap: 10rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.action-pass {
  color: #2f8b70;
  background: #e6f4ef;
}

.action-fail {
  color: #bf433e;
  background: #fbe9e8;
}
