.defect-page {
  padding: 22rpx 18rpx calc(140rpx + env(safe-area-inset-bottom));
  background: #f3f3f3;
}

.defect-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.defect-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 0 12rpx;
  color: #1d2733;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

.defect-marker {
  width: 12rpx;
  height: 30rpx;
  flex: 0 0 12rpx;
  background: #18a8e8;
}

.defect-card {
  min-height: 176rpx;
  padding: 18rpx 18rpx 16rpx;
  background: #ffffff;
  border: 0;
  border-radius: 14rpx;
  box-shadow: none;
}

.defect-block:active .defect-card {
  background: #f8fbfe;
}

.defect-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 42rpx;
  color: #6f7379;
  font-size: 28rpx;
  line-height: 1.45;
}

.defect-row text:last-child {
  min-width: 0;
  color: #111111;
  text-align: right;
  overflow-wrap: anywhere;
}

.defect-media-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 104rpx;
  margin: 2rpx 0 6rpx;
}

.media-labels {
  display: flex;
  flex-direction: column;
  color: #6f7379;
  font-size: 28rpx;
  line-height: 1.45;
}

.defect-image {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.defect-image--empty {
  border: 0;
}

.defect-tools {
  position: fixed;
  right: 16rpx;
  bottom: calc(92rpx + env(safe-area-inset-bottom));
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 22rpx rgba(31, 44, 58, 0.14);
}

.tool-button--light {
  color: #05b260;
  background: #ffffff;
}

.tool-button--primary {
  width: 72rpx;
  height: 72rpx;
  background: #18a8e8;
  color: #ffffff;
}
