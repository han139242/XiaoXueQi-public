.workbench-page {
  padding-top: 24rpx;
}

.action-title {
  margin-top: 0;
}

.business-title {
  margin-top: 34rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #dfe4e9;
  border-radius: 8rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 164rpx;
  margin: 0;
  padding: 22rpx 8rpx;
  color: #202a36;
  background: transparent;
  border-radius: 0;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
}

.action-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 12rpx;
  background: #e6f2fd;
  border-radius: 8rpx;
}

.action-item:active {
  background: #f8fbfe;
}

.business-grid {
  display: flex;
  align-items: stretch;
  width: 100%;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #dfe4e9;
  border-radius: 8rpx;
}

.business-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 50%;
  max-width: 50%;
  flex: 0 0 50%;
  min-width: 0;
  min-height: 164rpx;
  margin: 0;
  padding: 22rpx 8rpx;
  color: #202a36;
  background: transparent;
  border-radius: 0;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
}

.business-grid--three .business-item,
.business-item--third {
  width: 33.3333%;
  max-width: 33.3333%;
  flex-basis: 33.3333%;
}

.business-item:active {
  background: #f8fbfe;
}

.business-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  margin: 0 auto 12rpx;
  background: #e6f2fd;
  border-radius: 8rpx;
}

.business-symbol--danger {
  background: #fbe9e8;
}

.business-symbol--warning {
  background: #fff4dc;
}
