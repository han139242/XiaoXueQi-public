<view class="page workbench-page">
  <view class="workbench-heading">
    <view class="heading-main"><view class="heading-icon"><app-icon name="factory" size="42"></app-icon></view><view><text class="heading-title">生产工作台</text><text class="heading-subtitle">实时业务汇总</text></view></view>
    <button class="scan-action" bindtap="startScan" aria-label="扫码追溯"><app-icon name="scan-line" size="40" inverse></app-icon></button>
  </view>
  <loading-state wx:if="{{loading && metrics.length === 0}}"></loading-state>
  <empty-state wx:elif="{{error && metrics.length === 0}}" title="汇总数据加载失败" description="{{error}}" action-text="重试" bind:action="loadSummary"></empty-state>
  <view wx:else class="metric-grid">
    <view wx:for="{{metrics}}" wx:key="key" class="metric-item metric-item--{{item.tone}} {{index === 0 ? 'metric-item--wide' : ''}}">
      <view class="metric-top"><view class="metric-icon"><app-icon name="{{item.icon}}" size="34"></app-icon></view><text class="metric-label">{{item.label}}</text></view>
      <text class="metric-value">{{item.value}}</text>
    </view>
  </view>

  <view class="section-heading action-title"><view class="section-heading__main"><view class="section-heading__icon"><app-icon name="layout-grid" size="34"></app-icon></view><text class="section-heading__title">快捷入口</text></view><text class="section-heading__meta">常用操作</text></view>
  <view class="action-grid">
    <button data-url="/pages/work-order/index/index" bindtap="openTab"><view class="action-symbol"><app-icon name="clipboard-list" size="38"></app-icon></view><text>生产工单</text></button>
    <button data-url="/pages/task/index/index" bindtap="openTab"><view class="action-symbol"><app-icon name="list-checks" size="38"></app-icon></view><text>生产任务</text></button>
    <button data-url="/pages/report/index/index" bindtap="openTab"><view class="action-symbol"><app-icon name="file-text" size="38"></app-icon></view><text>报工记录</text></button>
    <button bindtap="startScan"><view class="action-symbol"><app-icon name="scan-line" size="38"></app-icon></view><text>扫码追溯</text></button>
  </view>
</view>
