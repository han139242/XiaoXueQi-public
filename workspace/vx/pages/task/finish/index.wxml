<view class="page page-with-actions">
  <loading-state wx:if="{{loading}}"></loading-state>
  <empty-state wx:elif="{{error && !task}}" title="任务加载失败" description="{{error}}" action-text="重试" bind:action="loadTask"></empty-state>
  <empty-state wx:elif="{{!task}}" title="任务不存在"></empty-state>
  <block wx:else>
    <view class="detail-hero"><view class="detail-hero__header"><view class="detail-hero__identity"><view class="detail-hero__icon"><app-icon name="circle-check-big" size="40"></app-icon></view><view><text class="detail-hero__number" selectable>{{task.taskNo || ('任务 ID ' + task.taskId)}}</text><text class="hero-type">完成任务</text></view></view><status-tag text="{{task.statusView.text}}" tone="{{task.statusView.tone}}"></status-tag></view></view>
    <view class="form-panel surface">
      <view class="section-heading"><view class="section-heading__main"><view class="section-heading__icon"><app-icon name="clipboard-check" size="34"></app-icon></view><text class="section-heading__title">完工数据</text></view></view>
      <label class="form-field"><text>最终完成数量</text><view class="control-shell"><app-icon name="badge-check" size="32" muted></app-icon><input type="digit" value="{{completedQuantity}}" data-field="completedQuantity" placeholder="请输入非负数字" bindinput="handleInput" /></view></label>
      <label class="form-field"><text>最终不良数量</text><view class="control-shell"><app-icon name="triangle-alert" size="32" muted></app-icon><input type="digit" value="{{defectQuantity}}" data-field="defectQuantity" placeholder="请输入非负数字" bindinput="handleInput" /></view></label>
      <label class="form-field"><text>备注</text><view class="textarea-shell"><app-icon name="notebook-pen" size="32" muted></app-icon><textarea value="{{remark}}" data-field="remark" maxlength="500" placeholder="选填，最多500字，请输入清晰说明" bindinput="handleInput"></textarea></view></label>
      <view wx:if="{{error}}" class="form-error"><app-icon name="triangle-alert" size="28"></app-icon><text>{{error}}</text></view>
    </view>
  </block>
</view>
<view wx:if="{{task}}" class="fixed-actions"><button class="primary-button" loading="{{submitting}}" disabled="{{submitting || loading}}" bindtap="submit"><app-icon name="circle-check-big" size="34" inverse></app-icon><text>确认完成</text></button></view>
