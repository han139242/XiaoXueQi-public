.task-filter-shell {
  padding: 0;
  background: #ffffff;
}

.reference-filter-bar {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  min-height: 90rpx;
}

.reference-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 90rpx;
  gap: 4rpx;
  padding: 0 4rpx;
  color: #59636e;
  font-size: 27rpx;
  line-height: 1.2;
}

.reference-filter--active {
  color: #14a8df;
}

.reference-filter text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reference-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  left: 0;
  z-index: 12;
  max-height: 540rpx;
  overflow-y: auto;
  background: #ffffff;
  border-top: 1rpx solid #edf0f3;
  box-shadow: 0 12rpx 28rpx rgba(32, 42, 54, 0.12);
}

.dropdown-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 0 32rpx;
  color: #4d5c6c;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f3;
  font-size: 29rpx;
}

.dropdown-option--active {
  color: #14a8df;
}

.task-list-page {
  padding-top: 18rpx;
  background: #f5f5f5;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.task-card {
  padding: 28rpx 30rpx 16rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.task-card:active {
  background: #f9fbfd;
}

.task-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.task-card__title {
  min-width: 0;
  flex: 1;
  color: #101418;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.task-status {
  flex: 0 0 auto;
  font-size: 29rpx;
  font-weight: 650;
}

.task-status--warning { color: #f5a500; }
.task-status--primary { color: #149ed9; }
.task-status--success { color: #2f9b67; }
.task-status--danger { color: #bf433e; }
.task-status--neutral { color: #8a96a3; }

.task-card__fields {
  margin-top: 12rpx;
}

.task-card__fields > view {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 4rpx 0;
  color: #8b8f94;
  font-size: 27rpx;
  line-height: 1.45;
}

.task-card__fields text:last-child {
  min-width: 0;
  color: #85898e;
  text-align: right;
  overflow-wrap: anywhere;
}

.task-card__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 50rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  color: #55585c;
  border-top: 1rpx solid #ececec;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1;
}
