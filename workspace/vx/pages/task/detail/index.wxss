.task-detail-page {
  padding-top: 24rpx;
  background: #f5f5f5;
}

.task-summary-card {
  padding: 28rpx 34rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.summary-title {
  min-width: 0;
  flex: 1;
  color: #101418;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.task-status {
  flex: 0 0 auto;
  font-size: 29rpx;
  font-weight: 650;
}

.task-status--warning { color: #f5a500; }
.task-status--primary { color: #149ed9; }
.task-status--success { color: #2f9b67; }
.task-status--danger { color: #bf433e; }
.task-status--neutral { color: #8a96a3; }

.summary-fields > view,
.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 26rpx;
  padding: 5rpx 0;
  color: #85898e;
  font-size: 27rpx;
  line-height: 1.45;
}

.summary-fields text:last-child,
.detail-row text:last-child {
  min-width: 0;
  color: #7e848a;
  text-align: right;
  overflow-wrap: anywhere;
}

.progress-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin: 28rpx -24rpx 24rpx;
  color: #3b91ff;
  background: #ffffff;
  border: 1rpx solid #e3e6e9;
  font-size: 31rpx;
  font-weight: 650;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.progress-card {
  padding: 28rpx 32rpx 18rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.progress-card--current {
  border-left: 5rpx solid #3b91ff;
}

.progress-card__title {
  display: block;
  color: #101418;
  font-size: 31rpx;
  font-weight: 650;
}

.progress-main,
.progress-quantity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #85898e;
  font-size: 27rpx;
}

.progress-quantity {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #ececec;
}

.progress-actions {
  display: flex;
  justify-content: flex-end;
  min-height: 62rpx;
  padding-top: 14rpx;
}

.progress-actions button {
  width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d9dde2;
  border-radius: 8rpx;
  font-size: 25rpx;
  line-height: 56rpx;
}

.detail-action {
  color: #303841;
  background: #ffffff;
}

.progress-actions .primary-action {
  color: #3b91ff;
  background: #ffffff;
  border-color: #cdddf2;
}

.expanded-details {
  margin-top: 28rpx;
  padding: 24rpx 30rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.expanded-title {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 0 12rpx;
  color: #202a36;
  border-top: 1rpx solid #ececec;
  font-size: 28rpx;
  font-weight: 650;
}

.expanded-title text:last-child {
  color: #8a96a3;
  font-size: 24rpx;
  font-weight: 400;
}

.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f1f2;
}

.report-no,
.report-meta {
  display: block;
}

.report-no {
  font-size: 26rpx;
  font-weight: 600;
}

.report-meta,
.report-count {
  margin-top: 5rpx;
  color: #8a96a3;
  font-size: 23rpx;
}

.report-count {
  flex: 0 0 auto;
  text-align: right;
}

.finish-action {
  height: 76rpx;
  margin-top: 20rpx;
  color: #ffffff;
  background: #3b91ff;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}
