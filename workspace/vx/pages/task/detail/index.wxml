<view class="page {{task && (task.status === 'WAIT_START' || task.status === 'RUNNING' || task.status === 'PAUSED') ? 'page-with-actions' : ''}}">
  <loading-state wx:if="{{loading}}"></loading-state>
  <empty-state wx:elif="{{error}}" title="任务详情加载失败" description="{{error}}" action-text="重试" bind:action="loadData"></empty-state>
  <empty-state wx:elif="{{!task}}" title="任务不存在" description="记录可能已删除"></empty-state>
  <block wx:else>
    <view class="detail-hero">
      <view class="detail-hero__header"><view class="detail-hero__identity"><view class="detail-hero__icon"><app-icon name="list-checks" size="40"></app-icon></view><view><text class="detail-hero__number" selectable>{{task.taskNo || ('任务 ID ' + task.taskId)}}</text><text class="hero-type">生产任务</text></view></view><status-tag text="{{task.statusView.text}}" tone="{{task.statusView.tone}}"></status-tag></view>
      <view class="task-context"><view><app-icon name="clipboard-list" size="27" muted></app-icon><text>{{task.workOrderLabel}}</text></view><view><app-icon name="list-checks" size="27" muted></app-icon><text>{{task.operationLabel}}</text></view><view><app-icon name="map-pin" size="27" muted></app-icon><text>{{task.stationLabel}}</text></view></view>
      <view class="progress-grid">
        <view><text class="progress-value">{{task.plannedQuantity == null ? '-' : task.plannedQuantity}}</text><text class="progress-label">计划数量</text></view>
        <view><text class="progress-value">{{task.completedQuantity == null ? '-' : task.completedQuantity}}</text><text class="progress-label">完成数量</text></view>
        <view><text class="progress-value defect">{{task.defectQuantity == null ? '-' : task.defectQuantity}}</text><text class="progress-label">不良数量</text></view>
      </view>
    </view>

    <view class="detail-section surface task-info"><view class="section-heading"><view class="section-heading__main"><view class="section-heading__icon"><app-icon name="info" size="34"></app-icon></view><text class="section-heading__title">执行信息</text></view></view><view class="field-row"><text class="field-label">创建时间</text><text class="field-value">{{task.createdTimeText}}</text></view><view class="field-row"><text class="field-label">备注</text><text class="field-value">{{task.remark || '-'}}</text></view></view>

    <view class="section-heading report-title"><view class="section-heading__main"><view class="section-heading__icon"><app-icon name="file-text" size="34"></app-icon></view><text class="section-heading__title">报工记录</text></view><text class="section-heading__meta">{{reports.length}} 条</text></view>
    <empty-state wx:if="{{reports.length === 0}}" title="暂无报工记录"></empty-state>
    <view wx:else class="record-list">
      <view wx:for="{{reports}}" wx:key="reportId" class="record-card" data-id="{{item.reportId}}" bindtap="openReport">
        <view class="record-header"><view class="record-identity"><view class="record-icon"><app-icon name="file-text" size="34"></app-icon></view><view><text class="record-number" selectable>{{item.reportNo || ('报工 ID ' + item.reportId)}}</text><text class="record-subline">{{item.operatorLabel}}</text></view></view><status-tag text="{{item.statusView.text}}" tone="{{item.statusView.tone}}"></status-tag></view>
        <view class="report-quantity"><text>合格 {{item.qualifiedQuantity}}</text><text class="defect-text">不良 {{item.defectQuantity}}</text></view>
        <view class="record-footer"><view class="record-time"><app-icon name="clock-3" size="25" muted></app-icon><text>{{item.reportTimeText}}</text></view><view class="card-link"><text>查看详情</text><app-icon name="chevron-right" size="25"></app-icon></view></view>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{task && task.status === 'WAIT_START'}}" class="fixed-actions"><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="startTask"><app-icon name="circle-play" size="34" inverse></app-icon><text>开始任务</text></button></view>
<view wx:elif="{{task && task.status === 'RUNNING'}}" class="fixed-actions action-row"><button class="secondary-button" disabled="{{submitting}}" bindtap="openReportForm"><app-icon name="notebook-pen" size="32"></app-icon><text>提交报工</text></button><button class="primary-button" disabled="{{submitting}}" bindtap="openFinish"><app-icon name="circle-check-big" size="32" inverse></app-icon><text>完成任务</text></button></view>
<view wx:elif="{{task && task.status === 'PAUSED'}}" class="fixed-actions"><button class="primary-button" bindtap="openFinish"><app-icon name="circle-check-big" size="34" inverse></app-icon><text>完成任务</text></button></view>
