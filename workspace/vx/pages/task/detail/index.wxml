<view class="page task-detail-page">
  <loading-state wx:if="{{loading}}"></loading-state>
  <empty-state wx:elif="{{error}}" title="任务详情加载失败" description="{{error}}" action-text="重试" bind:action="loadData"></empty-state>
  <empty-state wx:elif="{{!task}}" title="任务不存在" description="记录可能已删除"></empty-state>
  <block wx:else>
    <view class="task-summary-card">
      <view class="summary-header">
        <view class="summary-title-group">
          <text class="summary-title" selectable>{{task.taskNo || ('任务 ID ' + task.taskId)}}</text>
          <button wx:if="{{task.taskNo}}" class="summary-copy-button" aria-label="复制任务编号" catchtap="copyTaskNo"><app-icon name="copy" size="28" muted></app-icon></button>
        </view>
        <text class="task-status task-status--{{task.statusView.tone}}">{{task.statusView.text}}</text>
      </view>
      <view class="summary-fields">
        <view><text>工单编号</text><text selectable>{{task.workOrderLabel}}</text></view>
        <view><text>产品信息</text><text>{{product.productCode}} | {{product.productName}}</text></view>
        <view><text>计划时间</text><text>{{task.planTimeText}}</text></view>
        <view><text>计划数</text><text>{{task.plannedQuantity == null ? '-' : task.plannedQuantity}}</text></view>
        <view><text>实际数</text><text>{{task.actualQuantity}}</text></view>
        <view><text>良品数</text><text>{{task.qualifiedQuantity}}</text></view>
        <view><text>不良品数</text><text>{{task.defectQuantity == null ? 0 : task.defectQuantity}}</text></view>
      </view>
    </view>

    <view class="progress-heading">生产进度</view>

    <view class="progress-list">
      <view wx:for="{{progressTasks}}" wx:key="taskId" class="progress-card {{item.taskId === id ? 'progress-card--current' : ''}}">
        <text class="progress-card__title">{{item.operationLabel}}</text>
        <view class="progress-main"><text>计划数: {{item.plannedQuantity == null ? '-' : item.plannedQuantity}}</text></view>
        <view class="progress-quantity"><text>良品数: {{item.qualifiedQuantity}}</text><text>不良品数: {{item.defectQuantity == null ? 0 : item.defectQuantity}}</text></view>
        <view class="progress-actions">
          <button class="detail-action" data-id="{{item.taskId}}" bindtap="openProgressDetail">详情</button>
          <button wx:if="{{canStart && item.assignedToCurrentUser && item.status === 'WAIT_START'}}" class="primary-action" loading="{{submitting}}" disabled="{{submitting}}" data-id="{{item.taskId}}" bindtap="startTask">开工</button>
          <button wx:elif="{{canReport && item.assignedToCurrentUser && item.status === 'RUNNING' && !item.reportingComplete}}" class="primary-action" data-id="{{item.taskId}}" bindtap="openReportForm">报工</button>
          <button wx:elif="{{canFinish && item.assignedToCurrentUser && item.status === 'PAUSED'}}" class="primary-action" data-id="{{item.taskId}}" bindtap="openFinish">完工</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showDetails}}" class="expanded-details">
      <view class="detail-row"><text>工序</text><text>{{task.operationLabel}}</text></view>
      <view class="detail-row"><text>工位</text><text>{{task.stationLabel}}</text></view>
      <view class="detail-row"><text>创建时间</text><text>{{task.createdTimeText}}</text></view>
      <view class="detail-row"><text>备注</text><text>{{task.remark || '-'}}</text></view>
      <view class="expanded-title"><text>报工记录</text><text>{{reports.length}} 条</text></view>
      <empty-state wx:if="{{reports.length === 0}}" title="暂无报工记录"></empty-state>
      <view wx:else class="report-list">
        <view wx:for="{{reports}}" wx:key="reportId" class="report-row" data-id="{{item.reportId}}" bindtap="openReport">
          <view><text class="report-no" selectable>{{item.reportNo || ('报工 ID ' + item.reportId)}}</text><text class="report-meta">{{item.operatorLabel}} · {{item.reportTimeText}}</text></view>
          <text class="report-count">良品 {{item.qualifiedQuantity}} / 不良 {{item.defectQuantity}}</text>
        </view>
      </view>
      <button wx:if="{{canFinish && task.assignedToCurrentUser && (task.status === 'RUNNING' || task.status === 'PAUSED')}}" class="finish-action" data-id="{{task.taskId}}" bindtap="openFinish">完成当前任务</button>
    </view>
  </block>
</view>
