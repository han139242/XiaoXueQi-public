.list-page { padding-top: 18rpx; }

.reference-filter-bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  min-height: 90rpx;
}

.reference-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 90rpx;
  margin: 0;
  padding: 0 8rpx;
  gap: 6rpx;
  color: #69747f;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.reference-filter--active { color: #149ed9; }

.reference-filter text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reference-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  left: 0;
  z-index: 12;
  background: #ffffff;
  border-top: 1rpx solid #edf0f3;
  box-shadow: 0 12rpx 28rpx rgba(32, 42, 54, 0.12);
}

.dropdown-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  margin: 0;
  padding: 0 32rpx;
  color: #4d5c6c;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f3;
  border-radius: 0;
  font-size: 30rpx;
  line-height: 1.3;
  text-align: left;
}

.dropdown-option--active {
  color: #16a8c8;
}

.work-order-scan-fab {
  position: fixed;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #149ed9;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(20, 158, 217, 0.28);
}

.record-fields {
  padding: 2rpx 0;
}

.aligned-field {
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr);
  align-items: start;
  gap: 20rpx;
  min-height: 58rpx;
  padding: 9rpx 0;
  line-height: 1.45;
}

.aligned-label {
  color: #617080;
}

.aligned-value {
  min-width: 0;
  color: #202a36;
  text-align: right;
  overflow-wrap: anywhere;
}

.aligned-value--number { color: #5e6873; }
