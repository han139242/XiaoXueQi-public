<view class="filter-shell">
  <view class="reference-filter-bar">
    <view class="reference-filter {{filters.status ? 'reference-filter--active' : ''}}" data-field="status" bindtap="toggleDropdown"><text>状态</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
    <view class="reference-filter {{sortIndex ? 'reference-filter--active' : ''}}" data-field="sort" bindtap="toggleDropdown"><text>排序</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
    <view class="reference-filter {{filters.productId ? 'reference-filter--active' : ''}}" data-field="product" bindtap="toggleDropdown"><text>选择产品</text><app-icon name="chevron-down" size="22" muted></app-icon></view>
  </view>
  <view wx:if="{{activeDropdown}}" class="reference-dropdown">
    <view wx:for="{{dropdownOptions}}" wx:key="index" class="dropdown-option {{item.selected ? 'dropdown-option--active' : ''}}" data-field="{{activeDropdown}}" data-index="{{item.index}}" bindtap="selectDropdown">
      <text>{{item.label}}</text>
      <app-icon wx:if="{{item.selected}}" name="circle-check-big" size="30"></app-icon>
    </view>
  </view>
</view>

<view class="page list-page">
  <loading-state wx:if="{{loading && list.length === 0}}"></loading-state>
  <empty-state wx:elif="{{error && list.length === 0}}" title="工单加载失败" description="{{error}}" action-text="重试" bind:action="handleSearch"></empty-state>
  <empty-state wx:elif="{{!loading && list.length === 0}}" title="暂无工单" description="当前筛选条件下没有记录"></empty-state>

  <view wx:else class="record-list">
    <view wx:for="{{list}}" wx:key="workOrderId" class="record-card" data-id="{{item.workOrderId}}" bindtap="openDetail">
      <view class="record-header">
        <text class="record-number" selectable>{{item.workOrderNo || ('工单 ID ' + item.workOrderId)}}</text>
        <status-tag text="{{item.statusView.text}}" tone="{{item.statusView.tone}}"></status-tag>
      </view>
      <view class="record-fields">
        <view class="aligned-field"><text class="aligned-label">产品信息</text><text class="aligned-value">{{item.productLabel}}</text></view>
        <view class="aligned-field"><text class="aligned-label">计划数量</text><text class="aligned-value aligned-value--number">{{item.plannedQuantity == null ? '-' : item.plannedQuantity}}</text></view>
        <view class="aligned-field"><text class="aligned-label">实际数量</text><text class="aligned-value aligned-value--number">{{item.completedQuantity == null ? '-' : item.completedQuantity}}</text></view>
        <view class="aligned-field"><text class="aligned-label">创建时间</text><text class="aligned-value">{{item.createdTimeText}}</text></view>
      </view>
      <view class="record-footer"><text>查看详情</text><app-icon name="chevron-right" size="25" muted></app-icon></view>
    </view>
    <view wx:if="{{error}}" class="append-error" bindtap="onReachBottom">{{error}}，点击重试</view>
    <view wx:elif="{{loading}}" class="list-footer">加载中</view>
    <view wx:elif="{{finished}}" class="list-footer">已加载全部</view>
  </view>
  <view class="work-order-scan-fab" style="left: {{scanFabLeft}}px; top: {{scanFabTop}}px; width: {{scanFabSize}}px; height: {{scanFabSize}}px;" bindtap="startScan" bindtouchstart="handleScanFabTouchStart" bindtouchmove="handleScanFabTouchMove" bindtouchend="handleScanFabTouchEnd" aria-label="扫码录入工单"><app-icon name="scan-line" size="30" inverse></app-icon></view>
</view>
