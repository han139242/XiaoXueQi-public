#!/bin/sh

remote_name="$1"
failed=0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    ''|*[!0]*) ;;
    *) continue ;;
  esac

  case "$remote_oid" in
    ''|*[!0]*)
      if ! commits=$(git rev-list "$remote_oid..$local_oid"); then
        echo "[协作检查] 无法解析待推送提交范围，拒绝推送。"
        failed=1
        continue
      fi
      ;;
    *)
      if ! commits=$(git rev-list "$local_oid" --not --remotes="$remote_name"); then
        echo "[协作检查] 无法解析新分支的待推送提交，拒绝推送。"
        failed=1
        continue
      fi
      ;;
  esac

  for commit in $commits; do
    parent_count=$(git rev-list --parents -n 1 "$commit" | awk '{print NF - 1}')
    if [ "$parent_count" -gt 1 ]; then
      continue
    fi

    if ! git diff-tree --root --no-commit-id --name-only -r "$commit" | grep -qx 'COLLABORATION.md'; then
      subject=$(git log -1 --format='%s' "$commit")
      echo "[协作检查] 拒绝推送：提交 ${commit} 未更新 COLLABORATION.md。"
      echo "[协作检查] 提交说明：${subject}"
      failed=1
    fi
  done
done

if [ "$failed" -ne 0 ]; then
  echo "[协作检查] 请补充协作记录并修改对应提交后再推送。"
  exit 1
fi

echo "[协作检查] 待推送提交均包含 COLLABORATION.md，允许推送。"
exit 0
